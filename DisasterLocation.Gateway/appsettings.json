{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy.Forwarder": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Cors": {
    "AllowedOrigins": []
  },
  "Gateway": {
    "Frontend": "Original"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "Traffic": {
    "RequestsPerWindow": 1000,
    "WindowSeconds": 60,
    "ConcurrentRequests": 100
  },
  "ReverseProxy": {
    "Routes": {
      "disasters": {
        "ClusterId": "disasters-api",
        "Order": 0,
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/desastres",
          "Methods": [
            "GET",
            "POST"
          ]
        }
      },
      "disaster": {
        "ClusterId": "disasters-api",
        "Order": 0,
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/desastres/{id:int}",
          "Methods": [
            "GET"
          ]
        }
      }
    },
    "Clusters": {
      "disasters-api": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpClient": {
          "ConnectTimeout": "00:00:10"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:01"
          },
          "AvailableDestinationsPolicy": "HealthyAndUnknown"
        }
      }
    }
  }
}
