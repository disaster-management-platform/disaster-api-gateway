    "Clusters": {
      "reconstruction-api": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpClient": {
          "ConnectTimeout": "00:00:10"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:01"
          },
          "Active": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "Interval": "00:00:15",
            "Timeout": "00:00:03",
            "Path": "/api/reconstruccion/health"
          },
          "AvailableDestinationsPolicy": "HealthyAndUnknown"
        },
        "Destinations": {
          "local": {
            "Address": "http://localhost:5160/"
          }
        }
      }
